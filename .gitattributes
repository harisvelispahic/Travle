# Flutter regenerates these on every `pub get` / build and always writes LF. Without pinning them,
# a clone with core.autocrlf=true (the Git for Windows default) checks them out as CRLF, Flutter
# rewrites them as LF, and git then reports all of them as modified after any Flutter command even
# though the stored content is byte-for-byte identical.
**/flutter/generated_plugin_registrant.cc   text eol=lf
**/flutter/generated_plugin_registrant.h    text eol=lf
**/flutter/generated_plugins.cmake          text eol=lf
**/Flutter/GeneratedPluginRegistrant.swift  text eol=lf
