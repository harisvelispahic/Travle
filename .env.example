# Travle configuration template. Copy this file to `.env` and fill in real values.
# `.env` is gitignored (real secrets); at submission it ships as `.env-tajne.zip`.
# Compose reads these; ASP.NET binds the `Section__Key` names over appsettings.json.

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Development

# --- Host port mappings (host:container) ---
# Container ports are fixed (SQL 1433, API 5121); only the host side is configurable.
SQLSERVER_HOST_PORT=1435
API_HOST_PORT=5121

# --- Database ---
# MSSQL_SA_PASSWORD must satisfy SQL Server policy (>=8 chars, 3 of: upper/lower/digit/symbol)
# and MUST match the Password= in CONNECTION_STRING below.
# In CONNECTION_STRING, Server is the compose service name `travle-sqlserver` on the internal port 1433.
# DB name 230172 = student index without the IB prefix (course requirement).
MSSQL_SA_PASSWORD=Change_Me_Str0ng!
CONNECTION_STRING=Server=travle-sqlserver;Database=230172;User Id=sa;Password=Change_Me_Str0ng!;TrustServerCertificate=True;

# --- JWT ---
# Generate a real key locally — never with an online generator: this key signs every access
# token, so whoever has it can mint one for any user, including an admin.
#   openssl rand -hex 32      (Git Bash)
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=https://travle.com
JWT_AUDIENCE=http://travle.com
JWT_DURATION_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# --- App ---
# Base URL the Flutter apps target (mobile emulator uses 10.0.2.2, desktop uses localhost).
API_BASE_URL=http://localhost:5121
# Platform commission percentage, snapshotted per payment (bookkeeping only — no organizer payouts).
PLATFORM_FEE_PERCENTAGE=10
# Platform-wide fallback IANA time zone. A tour's event times are stored as UTC and displayed in the
# zone of its destination's city (City.TimeZoneId); this is the default when a city has no zone set and
# the zone the seeder assigns. Travle operates in Bosnia and Herzegovina. See docs/time-and-timezones.md.
PLATFORM_TIMEZONE=Europe/Sarajevo
# Pre-tour reminder window in hours (spec: 24). Widen it before a live demo — seeded departures
# rarely fall exactly 24 hours ahead of review time, so nothing would be due.
BOOKING_REMINDER_WINDOW_HOURS=24

# --- Payments (Stripe TEST mode — never live; no company/KYC involved) ---
# From the Stripe dashboard (Developers → API keys) after creating a free account. Test keys only.
#   STRIPE_SECRET_KEY      = sk_test_...  (server-side; never shipped to a client)
#   STRIPE_PUBLISHABLE_KEY = pk_test_...  (also passed to mobile via --dart-define)
#   STRIPE_WEBHOOK_SECRET  = whsec_...    (from `stripe listen`, or the dashboard webhook endpoint)
# Webhooks can't reach your machine on their own — run the Stripe CLI while developing:
#   stripe listen --forward-to localhost:5121/Payments/Webhook
# and copy the printed whsec_... into STRIPE_WEBHOOK_SECRET. See docs/payments-and-stripe.md.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- RabbitMQ ---
# RABBITMQ_HOST = compose service name (internal); *_HOST_PORT / *_MGMT_PORT are host mappings.
RABBITMQ_HOST=travle-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- SMTP (the worker sends email; the API never does) ---
# For the demo, Mailtrap (sandbox) is easiest: it captures mail in a web inbox — nothing reaches real
# people. Fill these with your provider's values. Leave SMTP_HOST empty to disable sending (the worker
# still starts and drains the queue, logging that mail is not configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@travle.com
SMTP_FROM_NAME=Travle
SMTP_USE_STARTTLS=true

# ==============================================================================
# Local (non-Docker) runs — ONLY what genuinely differs from the container.
#
# Everything else above is picked up automatically: Program.cs (API and Worker)
# aliases the plain names onto the `Section__Key` names .NET configuration binds
# — see Backend/Travle.Model/Configuration/EnvironmentConfigurationAliases.cs.
# So each secret is written ONCE, up top, and can no longer drift between two
# copies. docker-compose is unaffected: it sets the `Section__Key` names directly
# in each container, and an explicitly-set key always beats an alias.
#
# Only host-dependent values live below: the database server and the RabbitMQ host
# (both are compose service names inside the network, but localhost from the host
# machine). Add a `Section__Key` line here only when a local run must override a
# value from above. Nothing infrastructural lives in appsettings.json at all —
# no RabbitMQ, no SMTP, no JWT, no connection string (course §3.3).
# ==============================================================================
ConnectionStrings__DefaultConnection=Server=localhost,1435;Database=230172;User Id=sa;Password=Change_Me_Str0ng!;TrustServerCertificate=True;
RabbitMq__Host=localhost
